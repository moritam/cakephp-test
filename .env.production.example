# 本番サーバー用の環境変数 (docker compose が読み込む)
# このファイルを .env にコピーして値を設定する: cp .env.production.example .env
# .env は Git 管理外 (.gitignore)。

# 必須: ランダムな 64 文字 (openssl rand -hex 32 で作る)。一度決めたら変えない。
SECURITY_SALT=

# 必須: ブラウザで開く URL (Tailscale なら https://<マシン名>.<tailnet名>.ts.net)
APP_FULL_BASE_URL=

# 新規登録を受け付けるか。自分のアカウントは `docker compose exec app bin/cake user create <email>` で作る。
REGISTRATION_ENABLED=false

# Tailscale serve / Funnel などのプロキシ経由で接続する場合は true (127.0.0.1 でだけ待ち受けるので安全)
TRUST_PROXY=true

# HTTPS で配信する場合は true
COOKIE_SECURE=true

# 操作がないまま経過したらログアウトするまでの時間 (分)
SESSION_TIMEOUT=120

# ホスト側の待ち受けポート (127.0.0.1 のみ)
APP_PORT=8080
